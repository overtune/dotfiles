ulimit -n 10240

# --- oh-my-zsh -------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
# The fzf plugin sets up key bindings and picks fd as FZF_DEFAULT_COMMAND.
plugins=(git fzf docker-compose tmux)
# Skip oh-my-zsh's insecure-directory audit (saves ~50-100ms).
ZSH_DISABLE_COMPFIX=true
# oh-my-zsh runs compinit itself, reusing its cached dump.
source "$ZSH/oh-my-zsh.sh"

# --- Aliases ---------------------------------------------------------------
alias vim='nvim'
alias v='NVIM_APPNAME="nvim-overtune" nvim'
alias dc='docker-compose'
alias docker-nuke='docker stop $(docker ps -a -q) && docker rm $(docker ps -a -q) && docker system prune -a -f --volumes'
alias docker-rm='docker stop $(docker ps -a -q) && docker rm $(docker ps -a -q)'
alias ol="ls ~/Development/work"
alias nu="fnm use"
alias nd="fnm use default"

export DOCS_PATH="$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Docs/"

# --- Functions -------------------------------------------------------------
# fff file manager: cd into the directory it was in when it exits.
f() {
  fff "$@"
  cd "$(cat "${XDG_CACHE_HOME:=${HOME}/.cache}/fff/.fff_d")"
}

# Lazy-load thefuck: avoid spawning Python on every shell start.
fuck() {
  unset -f fuck
  eval "$(thefuck --alias)"
  fuck "$@"
}

# --- Tools -----------------------------------------------------------------
# Node version manager: fnm (https://github.com/Schniz/fnm).
# `--use-on-cd` auto-switches versions when entering a dir with .nvmrc / .node-version.
eval "$(fnm env --use-on-cd --shell zsh)"

export PATH="$HOME/.local/bin:$PATH"
# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

eval "$(mise activate zsh)"
